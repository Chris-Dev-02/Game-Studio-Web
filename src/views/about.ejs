<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title || "Game Studio" %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>

    <%- include("partials/navbar") %>

    <main>
        <section class="about">
            <% sections.forEach(section => { %>
                <article class="about-section">
                    <h2><%= section.title %></h2>
                    <p><%= section.description %></p>
                </article>
            <% }) %>
        </section>
    </main>

    <%- include("partials/footer") %>

</body>
</html>