<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title || "Game Studio" %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>

    <%- include("partials/navbar") %>

    <main>
        <section class="team">
            <h1>Our Team</h1>

            <div class="team-grid">
                <% team.forEach(member => { %>
                    <article class="team-card">
                        <img
                            src="<%= member.photo %>"
                            alt="<%= member.name %>"
                            class="team-photo"
                        >

                        <h2><%= member.name %></h2>
                        <h3><%= member.role %></h3>
                        <p><%= member.bio %></p>
                    </article>
                <% }) %>
            </div>
        </section>
    </main>

    <%- include("partials/footer") %>

</body>
</html>